# 1. Ignore everything by default (Blacklist approach)
/*

# 2. Whitelist necessary root config files and main scripts
!.gitignore
!README.md
!LICENSE
!requirements.txt
!pyproject.toml
!setup.py
!setup.cfg
!/test_phase1.py
!/shelfsim.py
!/diagnose.py

# 3. Whitelist core code & CAD directories
!/src/
!/src/**
!/cfd_opt/
!/cfd_opt/**
!/CAD_FILES/
!/CAD_FILES/**

# 3b. Whitelist the dryer optimizer source, but keep its local paper archive ignored
!/dryer_optimizer/
!/dryer_optimizer/**
/dryer_optimizer/research_papers/
/dryer_optimizer/research_papers/**
/dryer_optimizer/data/output/*
!/dryer_optimizer/data/output/.gitkeep
/dryer_optimizer/sldw_dump/*
!/dryer_optimizer/sldw_dump/.gitkeep

# 3b2. Ignore the cloned reference repositories under dryer research (the docs stay tracked)
/dryer_optimizer/research/reference_code/*/

# 4. Ignore build, environment, and cache artifacts
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.tox/
.nox/
*.egg-info/
dist/
build/
*.egg
/.vscode/
/.vscode/**
.idea/

# 5. Ignore non-essential project folders
/FM_AbdelRahman_35788/
/FM_AbdelRahman_35788/**
/georges_files_old/
/georges_files_old/**
/logys_files_m/
/logys_files_m/**
/some_useful_resources/
/some_useful_resources/**
/tasneem_files/
/tasneem_files/**
/test_files/
/test_files/**
/contamination_research1/
/contamination_research1/**
/esam_files/
/esam_files/**
/CAD files/
/CAD files/**
/CAD_workflow_files/
/CAD_workflow_files/**

# 6. Ignore heavy CFD meshes, Fluent transcripts, batch files, and images
*.msh.h5
*.sf
*.pmdb
*.wft
*.trn
/cleanup-fluent-*.bat
/CAD.msh.h5
/fig4_hjb_boundary_synergistic.png

