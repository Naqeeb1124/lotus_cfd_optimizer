# =====================================================================
# lotus_power - CFD Optimization Project
# .gitignore: Keep ONLY the cfd_opt/ directory with Python code
# Everything else in the repo root is ignored
# =====================================================================

# =====================================================================
# IGNORE EVERYTHING IN ROOT EXCEPT cfd_opt/
# =====================================================================
# First, ignore everything in root
/*

# Then explicitly allow the cfd_opt directory and its contents
!/cfd_opt/
!/cfd_opt/**
!/cfd_opt/py_files/
!/cfd_opt/py_files/*

# =====================================================================
# Explicitly ignore everything else in root
# =====================================================================

# Fluent transcript files (.trn)
*.trn

# Python files in root (not in cfd_opt)
/*.py

# Directories to ignore completely
/.venv/
/.venv/**
/.vscode/
/.vscode/**
/FM_AbdelRahman_35788/
/FM_AbdelRahman_35788/**
/georges_files_old/
/georges_files_old/**
/logys_files_m/
/logys_files_m/**
/some_useful_resources/
/some_useful_resources/**
/tasneem_files/
/tasneem_files/**
/test_files/
/test_files/**
/contamination_research1/
/contamination_research1/**
/esam_files/
/esam_files/**
/CAD files/
/CAD files/**
/CAD_workflow_files/
/CAD_workflow_files/**

# Specific root files to ignore
/shelfsim.py
/diagnose.py
/cleanup-fluent-AbdelRahman-10684.bat
/cleanup-fluent-AbdelRahman-27676.bat
/CAD.msh.h5
/fig4_hjb_boundary_synergistic.png

# =====================================================================
# Python / Virtual Environment
# =====================================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.tox/
.nox/
*.egg-info/
dist/
build/
*.egg

# =====================================================================
# IDE / Editor
# =====================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =====================================================================
# OS / Build artifacts
# =====================================================================
*.log
*.tmp
*.temp
*.bak
*.swp

# =====================================================================
# Keep these important files if they exist in root
# (Uncomment if you add them later)
# =====================================================================
!.gitignore
!README.md
!LICENSE
!requirements.txt
!pyproject.toml
!setup.py
!setup.cfg